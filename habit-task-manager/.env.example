# Copy this file to .env and fill in your own values before running the app.

# Port the server listens on
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host/database

# Secret used to sign login tokens. Use a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# How long a login stays valid for
JWT_EXPIRES_IN=30d

# Set to "production" when deployed
NODE_ENV=development
